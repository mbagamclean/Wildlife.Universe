# ─── Blogger target ──────────────────────────────────────────────────────────
# Create the blog at https://www.blogger.com (New blog), then paste its ID here.
# Find the ID in the Blogger dashboard URL: blogger.com/blog/posts/<BLOG_ID>
BLOGGER_BLOG_ID=

# Read-only API key (verified working 2026-07-04; CANNOT create posts)
BLOGGER_API_KEY=

# ─── Durable OAuth (required for publishing) ─────────────────────────────────
# Google Cloud Console (same project as the API key) → APIs & Services →
# Credentials → Create credentials → OAuth client ID → type "Desktop app".
# Then run once:  node --env-file=.env get-refresh-token.mjs
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=

# ─── Source: Wildlife Universe Supabase (public anon key) ────────────────────
SUPABASE_URL=https://msnllkjvhxzfoedgecva.supabase.co
SUPABASE_ANON_KEY=